{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"Quant_Report_20260303/","title":"Quant Report 20260303","text":""},{"location":"Quant_Report_20260303/#_1","title":"\u6bcf\u65e5\u57fa\u91d1\u91cf\u5316\u7b5b\u67e5\u4e0e\u4f30\u503c\u7814\u62a5","text":"<p>\u62a5\u544a\u65e5\u671f\uff1a 2023\u5e7410\u670827\u65e5</p>"},{"location":"Quant_Report_20260303/#_2","title":"\u4e00\u3001\u91cf\u5316\u6570\u636e\u6982\u89c8","text":"<p>\u672c\u6b21\u91cf\u5316\u7b5b\u67e5\u5171\u6d89\u53ca\u4e09\u53ea\u57fa\u91d1\u6807\u7684\uff0c\u5176\u5728\u7279\u5b9a\u56de\u6d4b\u533a\u95f4\u5185\u7684\u6838\u5fc3\u8868\u73b0\u6570\u636e\u5982\u4e0b\u8868\u6240\u793a\uff1a</p> \u6807\u7684\u57fa\u91d1\u4ee3\u7801 \u533a\u95f4\u6536\u76ca\u7387 (Return) \u6700\u5927\u56de\u64a4 (Max Drawdown) 003096 -43.76% -54.81% 005827 -28.19% -42.65% 460300 3.41% -31.54% <p>\u6570\u636e\u89e3\u8bfb\uff1a \u4ece\u6574\u4f53\u6570\u636e\u6765\u770b\uff0c\u672c\u6b21\u7b5b\u9009\u7684\u591a\u6570\u6807\u7684\u5728\u56de\u6d4b\u533a\u95f4\u5185\u8868\u73b0\u4e0d\u4f73\uff0c\u666e\u904d\u9762\u4e34\u8f83\u5927\u7684\u6d6e\u4e8f\u548c\u56de\u64a4\u98ce\u9669\uff0c\u663e\u793a\u51fa\u5f53\u524d\u5e02\u573a\u73af\u5883\u4e0b\u6295\u8d44\u7684\u590d\u6742\u6027\u548c\u6311\u6218\u6027\u3002</p>"},{"location":"Quant_Report_20260303/#_3","title":"\u4e8c\u3001\u5f02\u52a8\u70b9\u8bc4","text":"<ol> <li> <p>\u6781\u7aef\u4e0b\u884c\u98ce\u9669\u8b66\u793a\uff1a003096 \u4e0e 005827</p> <ul> <li>003096 \u8868\u73b0\u5c24\u4e3a\u75b2\u5f31\uff0c\u5f55\u5f97\u9ad8\u8fbe -43.76% \u7684\u533a\u95f4\u6536\u76ca\u7387\uff0c\u5e76\u4f34\u968f -54.81% \u7684\u6700\u5927\u56de\u64a4\u3002\u8fd9\u4e00\u6570\u636e\u8868\u660e\uff0c\u5728\u8003\u5bdf\u671f\u5185\uff0c\u8be5\u57fa\u91d1\u8d44\u4ea7\u51c0\u503c\u906d\u53d7\u4e86\u6bc1\u706d\u6027\u7684\u4fb5\u8680\uff0c\u4e14\u6295\u8d44\u8005\u53ef\u80fd\u7ecf\u5386\u4e86\u8d85\u8fc7\u4e00\u534a\u7684\u8d44\u672c\u635f\u5931\u3002\u6781\u9ad8\u7684\u6700\u5927\u56de\u64a4\u4e5f\u9884\u793a\u7740\u5176\u6ce2\u52a8\u6027\u6781\u5f3a\uff0c\u98ce\u9669\u655e\u53e3\u5de8\u5927\u3002</li> <li>005827 \u867d\u7136\u7565\u4f18\u4e8e003096\uff0c\u4f46 -28.19% \u7684\u6536\u76ca\u7387\u548c -42.65% \u7684\u6700\u5927\u56de\u64a4 \u4e5f\u7edd\u975e\u7406\u60f3\u8868\u73b0\u3002\u5176\u9762\u4e34\u7684\u4e0b\u884c\u98ce\u9669\u548c\u8d44\u672c\u635f\u5931\u540c\u6837\u663e\u8457\u3002</li> <li>\u70b9\u8bc4\uff1a \u8fd9\u4e24\u53ea\u57fa\u91d1\u7684\u6df1\u5c42\u4e8f\u635f\u548c\u9ad8\u56de\u64a4\u53ef\u80fd\u4e0e\u5176\u91cd\u4ed3\u884c\u4e1a\u3001\u6295\u8d44\u7b56\u7565\u6216\u672a\u80fd\u9002\u5e94\u5e02\u573a\u98ce\u683c\u53d8\u5316\u7b49\u56e0\u7d20\u7d27\u5bc6\u76f8\u5173\u3002\u6295\u8d44\u8005\u9700\u5bf9\u5176\u80cc\u540e\u7684\u6295\u8d44\u903b\u8f91\u8fdb\u884c\u6df1\u5165\u5256\u6790\uff0c\u5e76\u8b66\u60d5\u5176\u672a\u6765\u6301\u7eed\u8dd1\u8f93\u5e02\u573a\u7684\u53ef\u80fd\u6027\u3002\u4ece\u7eaf\u91cf\u5316\u6570\u636e\u6765\u770b\uff0c\u5b83\u4eec\u5728\u5f53\u524d\u56de\u6d4b\u5468\u671f\u5185\u672a\u80fd\u6709\u6548\u7ba1\u7406\u98ce\u9669\u5e76\u4fdd\u62a4\u6295\u8d44\u8005\u672c\u91d1\u3002</li> </ul> </li> <li> <p>\u9006\u52bf\u4e2d\u7684\u97e7\u6027\u4e0e\u6ce2\u52a8\uff1a460300</p> <ul> <li>460300 \u662f\u672c\u6b21\u7b5b\u67e5\u4e2d\u552f\u4e00\u5b9e\u73b0\u6b63\u6536\u76ca\u7684\u6807\u7684\uff0c\u5f55\u5f97 3.41% \u7684\u533a\u95f4\u6536\u76ca\u7387\u3002\u5728\u5176\u4ed6\u6807\u7684\u666e\u904d\u5f55\u5f97\u5927\u5e45\u4e8f\u635f\u7684\u80cc\u666f\u4e0b\uff0c\u8fd9\u5c55\u73b0\u51fa\u4e86\u4e00\u5b9a\u7684\u8d85\u989d\u6536\u76ca\u80fd\u529b\u6216\u72ec\u7279\u7684\u6297\u8dcc/\u53cd\u5f39\u673a\u5236\u3002</li> <li>\u7136\u800c\uff0c\u5176 -31.54% \u7684\u6700\u5927\u56de\u64a4 \u540c\u6837\u4e0d\u5bb9\u5ffd\u89c6\u3002\u8fd9\u610f\u5473\u7740\u5373\u4f7f\u662f\u5b9e\u73b0\u4e86\u6b63\u6536\u76ca\uff0c\u8be5\u57fa\u91d1\u5728\u8003\u5bdf\u671f\u5185\u4e5f\u7ecf\u5386\u4e86\u663e\u8457\u7684\u5e02\u573a\u6ce2\u52a8\u548c\u9636\u6bb5\u6027\u4e8f\u635f\u3002</li> <li>\u70b9\u8bc4\uff1a \u5bf9\u4e8e460300\uff0c\u6295\u8d44\u8005\u5e94\u6df1\u5165\u7814\u7a76\u5176\u5b9e\u73b0\u6b63\u6536\u76ca\u7684\u9a71\u52a8\u56e0\u7d20\uff0c\u662f\u5f97\u76ca\u4e8e\u5176\u7b56\u7565\u7684\u97e7\u6027\u3001\u8d44\u4ea7\u914d\u7f6e\u7684\u6709\u6548\u6027\uff0c\u8fd8\u662f\u4e3b\u8981\u7531\u540e\u671f\u7279\u5b9a\u4e8b\u4ef6\u9a71\u52a8\u7684\u53cd\u5f39\u3002\u540c\u65f6\uff0c\u5e94\u5bf9\u5176\u8f83\u5927\u7684\u56de\u64a4\u4fdd\u6301\u8b66\u60d5\uff0c\u8fd9\u610f\u5473\u7740\u5176\u6295\u8d44\u8fc7\u7a0b\u5e76\u975e\u4e00\u5e06\u98ce\u987a\uff0c\u53ef\u80fd\u4f34\u968f\u8f83\u9ad8\u7684\u60c5\u7eea\u8003\u9a8c\u3002\u8fdb\u4e00\u6b65\u5206\u6790\u5176\u98ce\u9669\u8c03\u6574\u540e\u6536\u76ca\u6307\u6807\uff08\u5982\u590f\u666e\u6bd4\u7387\u3001\u7d22\u63d0\u8bfa\u6bd4\u7387\uff09\u5c06\u63d0\u4f9b\u66f4\u5168\u9762\u7684\u8bc4\u4f30\u89c6\u89d2\u3002</li> </ul> </li> </ol>"},{"location":"Quant_Report_20260303/#_4","title":"\u4e09\u3001\u98ce\u9669\u63d0\u793a","text":"<ol> <li>\u9ad8\u4e8f\u635f\u4e0e\u5927\u56de\u64a4\u6807\u7684\u98ce\u9669\uff1a \u5bf9\u4e8e003096\u548c005827\u8fd9\u7c7b\u9ad8\u4e8f\u635f\u3001\u5927\u56de\u64a4\u7684\u57fa\u91d1\uff0c\u6295\u8d44\u8005\u5e94\u6781\u5ea6\u8c28\u614e\u3002\u5386\u53f2\u6570\u636e\u663e\u793a\u5176\u5728\u7279\u5b9a\u5468\u671f\u5185\u672a\u80fd\u6709\u6548\u62b5\u5fa1\u5e02\u573a\u98ce\u9669\uff0c\u4e14\u4fee\u590d\u5982\u6b64\u5de8\u5927\u7684\u4e8f\u635f\u901a\u5e38\u9700\u8981\u6781\u957f\u7684\u65f6\u95f4\u548c\u6781\u9ad8\u7684\u590d\u5408\u589e\u957f\u7387\uff0c\u8d44\u672c\u6548\u7387\u4f4e\u4e0b\u3002\u5728\u672a\u6709\u660e\u786e\u62d0\u70b9\u4fe1\u53f7\u548c\u6df1\u5165\u57fa\u672c\u9762\u652f\u6491\u524d\uff0c\u76f2\u76ee\u4ecb\u5165\u5b58\u5728\u6781\u5927\u7684\u98ce\u9669\u3002</li> <li>\u6b63\u6536\u76ca\u6807\u7684\u9690\u85cf\u98ce\u9669\uff1a \u5373\u4f7f\u662f\u5b9e\u73b0\u6b63\u6536\u76ca\u7684460300\uff0c\u5176\u8d85\u8fc730%\u7684\u6700\u5927\u56de\u64a4\u4e5f\u63d0\u793a\u6295\u8d44\u8005\uff0c\u8be5\u57fa\u91d1\u7684\u6ce2\u52a8\u6027\u4e0d\u4f4e\u3002\u5355\u4e00\u7684\u533a\u95f4\u6536\u76ca\u7387\u4e0d\u8db3\u4ee5\u5168\u9762\u8bc4\u4f30\u5176\u6295\u8d44\u4ef7\u503c\uff0c\u987b\u7ed3\u5408\u5176\u56de\u64a4\u7279\u5f81\u3001\u98ce\u9669\u8c03\u6574\u540e\u6536\u76ca\u4ee5\u53ca\u5176\u7b56\u7565\u7684\u957f\u671f\u53ef\u6301\u7eed\u6027\u8fdb\u884c\u8003\u91cf\u3002\u4efb\u4f55\u57fa\u91d1\u7684\u56de\u6d4b\u6570\u636e\u90fd\u4e0d\u80fd\u5b8c\u5168\u4ee3\u8868\u5176\u672a\u6765\u8868\u73b0\u3002</li> <li>\u5168\u9762\u5c3d\u804c\u8c03\u67e5\u7684\u91cd\u8981\u6027\uff1a \u672c\u62a5\u544a\u4ec5\u57fa\u4e8e\u63d0\u4f9b\u7684\u6838\u5fc3\u91cf\u5316\u6570\u636e\u8fdb\u884c\u521d\u6b65\u5206\u6790\u3002\u5728\u8fdb\u884c\u6700\u7ec8\u6295\u8d44\u51b3\u7b56\u524d\uff0c\u5efa\u8bae\u6295\u8d44\u8005\u8fdb\u884c\u66f4\u5168\u9762\u7684\u5c3d\u804c\u8c03\u67e5\uff0c\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u6df1\u5165\u7814\u7a76\u57fa\u91d1\u7684\u6295\u8d44\u7b56\u7565\u3001\u8d44\u4ea7\u914d\u7f6e\u3001\u6301\u4ed3\u660e\u7ec6\u3001\u57fa\u91d1\u7ecf\u7406\u7ba1\u7406\u80fd\u529b\u3001\u5386\u53f2\u4e1a\u7ee9\u5f52\u56e0\u3001\u8d39\u7528\u7ed3\u6784\u3001\u4ee5\u53ca\u7ed3\u5408\u5b8f\u89c2\u7ecf\u6d4e\u548c\u884c\u4e1a\u8d8b\u52bf\u7684\u5206\u6790\u3002\u5355\u4e00\u6307\u6807\u6216\u77ed\u671f\u6570\u636e\u4e0d\u8db3\u4ee5\u652f\u6491\u957f\u671f\u4e14\u7a33\u5065\u7684\u6295\u8d44\u51b3\u7b56\u3002</li> <li>\u98ce\u9669\u7ba1\u7406\u4e0e\u591a\u5143\u5316\uff1a \u9274\u4e8e\u672c\u6b21\u7b5b\u67e5\u4e2d\u57fa\u91d1\u8868\u73b0\u7684\u5206\u5316\uff0c\u4ee5\u53ca\u666e\u904d\u5b58\u5728\u7684\u8f83\u5927\u56de\u64a4\uff0c\u518d\u6b21\u5f3a\u8c03\u591a\u5143\u5316\u6295\u8d44\u548c\u4e25\u683c\u7684\u98ce\u9669\u7ba1\u7406\u5bf9\u4e8e\u4fdd\u62a4\u6295\u8d44\u8005\u8d44\u672c\u7684\u91cd\u8981\u6027\u3002\u6295\u8d44\u8005\u5e94\u6839\u636e\u81ea\u8eab\u7684\u98ce\u9669\u627f\u53d7\u80fd\u529b\uff0c\u6784\u5efa\u5206\u6563\u5316\u7684\u6295\u8d44\u7ec4\u5408\uff0c\u907f\u514d\u8fc7\u5ea6\u96c6\u4e2d\u4e8e\u4efb\u4f55\u5355\u4e00\u6807\u7684\u3002</li> </ol> <p>\u514d\u8d23\u58f0\u660e\uff1a \u672c\u62a5\u544a\u4ec5\u4e3a\u57fa\u4e8e\u516c\u5f00\u6570\u636e\u5206\u6790\u7684\u91cf\u5316\u53c2\u8003\u4fe1\u606f\uff0c\u4e0d\u6784\u6210\u4efb\u4f55\u6295\u8d44\u5efa\u8bae\u3002\u6295\u8d44\u8005\u5e94\u72ec\u7acb\u5224\u65ad\uff0c\u98ce\u9669\u81ea\u8d1f\u3002</p>"}]}