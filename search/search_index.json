{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"Quant_Report_20260303/","title":"\u6bcf\u65e5\u57fa\u91d1\u91cf\u5316\u7b5b\u67e5\u4e0e\u4f30\u503c\u7814\u62a5","text":"<p>\u62a5\u544a\u65e5\u671f\uff1a2023\u5e7410\u670827\u65e5</p>"},{"location":"Quant_Report_20260303/#1","title":"1. \u91cf\u5316\u6570\u636e\u6982\u89c8","text":"<p>\u672c\u65e5\u91cf\u5316\u7b5b\u67e5\u6837\u672c\u96c6\u4e2d\uff0c\u6211\u4eec\u5bf9\u4e09\u652f\u57fa\u91d1\u5728\u7279\u5b9a\u56de\u6d4b\u533a\u95f4\u5185\u7684\u6838\u5fc3\u8868\u73b0\u6570\u636e\u8fdb\u884c\u4e86\u5206\u6790\u3002\u4ee5\u4e0b\u662f\u672c\u6b21\u7b5b\u67e5\u7684\u91cf\u5316\u6570\u636e\u6982\u89c8\uff1a</p> \u57fa\u91d1\u4ee3\u7801 \u533a\u95f4\u6536\u76ca\u7387 \u6700\u5927\u56de\u64a4 003096 -43.76% -54.81% 005827 -28.19% -42.65% 460300 3.41% -31.54% <p>\u672c\u6b21\u7b5b\u67e5\u7684\u57fa\u91d1\u6837\u672c\u663e\u793a\uff0c\u5728\u7ed9\u5b9a\u56de\u6d4b\u533a\u95f4\u5185\uff0c\u5e02\u573a\u6216\u76f8\u5173\u677f\u5757\u8868\u73b0\u666e\u904d\u627f\u538b\uff0c\u591a\u6570\u57fa\u91d1\u5f55\u5f97\u8d1f\u6536\u76ca\uff0c\u4e14\u4f34\u968f\u8f83\u5927\u56de\u64a4\uff0c\u8868\u660e\u8be5\u671f\u95f4\u6574\u4f53\u6295\u8d44\u73af\u5883\u9762\u4e34\u663e\u8457\u6311\u6218\u3002</p>"},{"location":"Quant_Report_20260303/#2","title":"2. \u5f02\u52a8\u70b9\u8bc4","text":""},{"location":"Quant_Report_20260303/#21-003096","title":"2.1 \u57fa\u91d1 003096\uff1a\u6df1\u5ea6\u4e8f\u635f\u4e0e\u8d85\u9ad8\u56de\u64a4","text":"<p>\u8be5\u57fa\u91d1\u5f55\u5f97-43.76%\u7684\u533a\u95f4\u6536\u76ca\u7387\uff0c\u540c\u65f6\u6700\u5927\u56de\u64a4\u9ad8\u8fbe-54.81%\u3002\u8fd9\u4e00\u8868\u73b0\u63ed\u793a\u4e86\u57fa\u91d1\u5728\u56de\u6d4b\u671f\u5185\u9762\u4e34\u6781\u5927\u7684\u4e0b\u884c\u98ce\u9669\u548c\u8d44\u4ea7\u51c0\u503c\u4fb5\u8680\u3002\u5982\u6b64\u6df1\u5ea6\u7684\u4e8f\u635f\u548c\u56de\u64a4\uff0c\u53ef\u80fd\u6e90\u4e8e\u5176\u91cd\u4ed3\u884c\u4e1a\u6216\u4e2a\u80a1\u906d\u9047\u7cfb\u7edf\u6027\u98ce\u9669\uff0c\u4ea6\u6216\u662f\u57fa\u91d1\u7ecf\u7406\u7684\u6295\u8d44\u7b56\u7565\u672a\u80fd\u6709\u6548\u5e94\u5bf9\u5e02\u573a\u6ce2\u52a8\u3002\u5728\u8003\u8651\u6b64\u7c7b\u8d44\u4ea7\u65f6\uff0c\u9700\u7279\u522b\u5173\u6ce8\u5176\u6295\u8d44\u7ec4\u5408\u7684\u7ed3\u6784\u6027\u5f31\u70b9\u4ee5\u53ca\u6f5c\u5728\u7684\u6d41\u52a8\u6027\u98ce\u9669\u3002\u5efa\u8bae\u5bf9\u6b64\u57fa\u91d1\u8fdb\u884c\u6df1\u5165\u7684\u57fa\u672c\u9762\u5206\u6790\uff0c\u7279\u522b\u662f\u5176\u6301\u4ed3\u96c6\u4e2d\u5ea6\u3001\u884c\u4e1a\u66b4\u9732\u4ee5\u53ca\u7b56\u7565\u7a33\u5b9a\u6027\u3002</p>"},{"location":"Quant_Report_20260303/#22-005827","title":"2.2 \u57fa\u91d1 005827\uff1a\u663e\u8457\u627f\u538b\u4f46\u76f8\u5bf9\u7f13\u548c","text":"<p>\u76f8\u8f83\u4e8e003096\uff0c005827\u7684\u533a\u95f4\u6536\u76ca\u7387\u548c\u6700\u5927\u56de\u64a4\u7565\u4f18\uff0c\u5206\u522b\u4e3a-28.19%\u548c-42.65%\u3002\u5c3d\u7ba1\u8868\u73b0\u76f8\u5bf9\u8f83\u597d\uff0c\u4f46\u9ad8\u8fbe\u56db\u6210\u7684\u6700\u5927\u56de\u64a4\u548c\u8fd1\u4e09\u6210\u7684\u8d1f\u6536\u76ca\u4f9d\u7136\u8868\u660e\u8be5\u57fa\u91d1\u5728\u56de\u6d4b\u533a\u95f4\u5185\u627f\u53d7\u4e86\u663e\u8457\u7684\u8d44\u672c\u635f\u5931\u98ce\u9669\u3002\u8fd9\u53ef\u80fd\u6697\u793a\u5176\u6295\u8d44\u7ec4\u5408\u4e0e003096\u5b58\u5728\u4e00\u5b9a\u7684\u5171\u6027\u98ce\u9669\u66b4\u9732\uff0c\u6216\u540c\u6837\u8eab\u5904\u6311\u6218\u6027\u5e02\u573a\u73af\u5883\u4e2d\uff0c\u4f46\u53ef\u80fd\u5728\u98ce\u9669\u7ba1\u7406\u6216\u8d44\u4ea7\u914d\u7f6e\u4e0a\u6709\u6240\u4fa7\u91cd\uff0c\u4f7f\u5176\u4e0b\u884c\u5e45\u5ea6\u7565\u5c0f\u4e8e\u524d\u8005\u3002\u9700\u5173\u6ce8\u5176\u8d44\u4ea7\u914d\u7f6e\u7684\u591a\u5143\u5316\u7a0b\u5ea6\u53ca\u98ce\u9669\u63a7\u5236\u63aa\u65bd\u7684\u6709\u6548\u6027\u3002</p>"},{"location":"Quant_Report_20260303/#23-460300","title":"2.3 \u57fa\u91d1 460300\uff1a\u9006\u52bf\u6b63\u6536\u76ca\u4e0b\u7684\u6ce2\u52a8\u6027\u8003\u91cf","text":"<p>\u5728\u672c\u6b21\u7b5b\u67e5\u4e2d\uff0c460300\u662f\u552f\u4e00\u5f55\u5f97\u6b63\u6536\u76ca\u7684\u57fa\u91d1\uff0c\u533a\u95f4\u6536\u76ca\u7387\u4e3a3.41%\u3002\u5c3d\u7ba1\u5176\u6700\u5927\u56de\u64a4\u4e5f\u8fbe\u5230-31.54%\uff0c\u8868\u660e\u5176\u51c0\u503c\u6ce2\u52a8\u5267\u70c8\uff0c\u4f46\u5728\u666e\u904d\u4e0b\u884c\u7684\u5e02\u573a\u73af\u5883\u4e2d\u5b9e\u73b0\u6b63\u6536\u76ca\uff0c\u5b9e\u5c5e\u4e0d\u6613\u3002\u8fd9\u4e00\u8868\u73b0\u53ef\u80fd\u9884\u793a\u7740\u8be5\u57fa\u91d1\u5177\u5907\u8f83\u5f3a\u7684\u963f\u5c14\u6cd5\u83b7\u53d6\u80fd\u529b\u3001\u6709\u6548\u7684\u98ce\u9669\u7ba1\u7406\u7b56\u7565\uff0c\u6216\u8005\u5176\u6295\u8d44\u6807\u7684\u5728\u7279\u5b9a\u65f6\u671f\u5c55\u73b0\u51fa\u97e7\u6027\u4e0e\u6210\u957f\u6027\u3002\u9274\u4e8e\u5176\u5728\u6311\u6218\u671f\u5185\u8868\u73b0\u51fa\u7684\u76f8\u5bf9\u4f18\u52bf\uff0c\u5efa\u8bae\u91cd\u70b9\u5173\u6ce8\u5176\u8d85\u989d\u6536\u76ca\u7684\u6765\u6e90\u3001\u7b56\u7565\u7684\u6301\u7eed\u6027\u4ee5\u53ca\u5176\u98ce\u9669\u6536\u76ca\u7279\u5f81\u7684\u5339\u914d\u5ea6\u3002\u5bf9\u5176\u8f83\u9ad8\u56de\u64a4\u7684\u6210\u56e0\u5206\u6790\uff0c\u6709\u52a9\u4e8e\u7406\u89e3\u5176\u6536\u76ca\u7684\u8d28\u91cf\u4e0e\u53ef\u6301\u7eed\u6027\u3002</p>"},{"location":"Quant_Report_20260303/#3","title":"3. \u98ce\u9669\u63d0\u793a","text":"<p>\u672c\u6b21\u56de\u6d4b\u6570\u636e\u96c6\u4e2d\u63ed\u793a\u4e86\u5f53\u524d\u5e02\u573a\uff08\u6216\u7279\u5b9a\u6295\u8d44\u4e3b\u9898\uff09\u7684\u4e25\u5cfb\u6027\uff0c\u5927\u591a\u6570\u6837\u672c\u57fa\u91d1\u5728\u7ed9\u5b9a\u533a\u95f4\u5185\u5f55\u5f97\u663e\u8457\u7684\u8d1f\u6536\u76ca\u548c\u9ad8\u56de\u64a4\u3002\u6295\u8d44\u8005\u5728\u8003\u91cf\u8fd9\u7c7b\u8868\u73b0\u7684\u57fa\u91d1\u65f6\uff0c\u52a1\u5fc5\u7ed3\u5408\u81ea\u8eab\u7684\u98ce\u9669\u627f\u53d7\u80fd\u529b\u3001\u6295\u8d44\u76ee\u6807\u548c\u6295\u8d44\u671f\u9650\u3002</p> <p>\u5355\u4e00\u7684\u56de\u6d4b\u533a\u95f4\u548c\u6838\u5fc3\u6307\u6807\u4e0d\u8db3\u4ee5\u5168\u9762\u8bc4\u4f30\u57fa\u91d1\u7684\u957f\u671f\u4ef7\u503c\u548c\u98ce\u9669\u3002\u6211\u4eec\u5f3a\u8c03\uff0c\u6700\u5927\u56de\u64a4\u548c\u533a\u95f4\u6536\u76ca\u7387\u662f\u91cd\u8981\u7684\u98ce\u9669\u6536\u76ca\u6307\u6807\uff0c\u4f46\u5e76\u975e\u552f\u4e00\u51b3\u7b56\u4f9d\u636e\u3002\u5728\u505a\u51fa\u4efb\u4f55\u6295\u8d44\u51b3\u7b56\u524d\uff0c\u5e94\u7ed3\u5408\u66f4\u5168\u9762\u7684\u91cf\u5316\u6307\u6807\uff08\u5982\u590f\u666e\u6bd4\u7387\u3001\u7d22\u63d0\u8bfa\u6bd4\u7387\u3001\u6ce2\u52a8\u7387\u3001\u963f\u5c14\u6cd5\u3001\u8d1d\u5854\u7b49\uff09\uff0c\u4ee5\u53ca\u5bf9\u57fa\u91d1\u7ecf\u7406\u3001\u6295\u8d44\u7b56\u7565\u3001\u6301\u4ed3\u7ed3\u6784\u3001\u8d39\u7528\u7b49\u8fdb\u884c\u6df1\u5ea6\u7814\u7a76\u3002\u5bf9\u4e8e\u8868\u73b0\u4e0d\u4f73\u7684\u57fa\u91d1\uff0c\u9700\u8b66\u60d5\u5176\u672a\u6765\u53ef\u80fd\u9762\u4e34\u7684\u8d4e\u56de\u538b\u529b\u548c\u6d41\u52a8\u6027\u98ce\u9669\uff1b\u5bf9\u4e8e\u9006\u52bf\u8868\u73b0\u7684\u57fa\u91d1\uff0c\u5219\u9700\u5ba1\u614e\u8bc4\u4f30\u5176\u8d85\u989d\u6536\u76ca\u7684\u53ef\u6301\u7eed\u6027\u53ca\u80cc\u540e\u7684\u98ce\u9669\u655e\u53e3\u3002</p> <p>\u5e02\u573a\u6709\u98ce\u9669\uff0c\u6295\u8d44\u9700\u8c28\u614e\u3002\u672c\u62a5\u544a\u4ec5\u4e3a\u91cf\u5316\u5206\u6790\u521d\u6b65\u7ed3\u679c\uff0c\u4e0d\u6784\u6210\u4efb\u4f55\u6295\u8d44\u5efa\u8bae\u3002</p>"}]}