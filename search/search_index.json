{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"Quant_Report_20260303/","title":"Quant Report 20260303","text":""},{"location":"Quant_Report_20260303/#_1","title":"\u91cf\u5316\u57fa\u51c6\u6d4b\u7b97\u4e0e\u8d8b\u52bf\u7814\u62a5","text":"<p>\u62a5\u544a\u65e5\u671f\uff1a[\u5f53\u524d\u65e5\u671f]</p>"},{"location":"Quant_Report_20260303/#_2","title":"\u5e02\u573a\u52a8\u80fd\u6982\u89c8","text":"<p>\u5f53\u524d\u76d1\u6d4b\u7684\u57fa\u91d1\u6c60\u663e\u793a\u51fa\u5206\u5316\u8d8b\u52bf\uff0c\u4f46\u6574\u4f53\u7a7a\u5934\u52a8\u80fd\u5360\u636e\u4e3b\u5bfc\u3002\u5728\u4e09\u4e2a\u6807\u7684\u4e2d\uff0c\u6709\u4e24\u53ea\u57fa\u91d1\uff08003096, 005827\uff09\u660e\u786e\u5904\u4e8e\u7a7a\u5934\u5468\u671f\uff0c\u5176\u51c0\u503c\u5747\u5df2\u8dcc\u7834MA20\uff0c\u4e14MACD\u7eff\u67f1\u653e\u5927\uff0c\u8868\u660e\u4e0b\u884c\u8d8b\u52bf\u6b63\u5728\u52a0\u901f\u3002\u4ec5\u6709\u4e00\u53ea\u57fa\u91d1\uff08460300\uff09\u5c55\u73b0\u51fa\u591a\u5934\u683c\u5c40\uff0c\u51c0\u503c\u4f4d\u4e8eMA20\u4e0a\u65b9\uff0cMACD\u7ea2\u67f1\u653e\u5927\uff0c\u663e\u793a\u5176\u591a\u5934\u52a8\u80fd\u6b63\u5728\u5f3a\u5316\u3002\u9274\u4e8e\u7a7a\u5934\u6807\u7684\u5360\u591a\u6570\uff0c\u57fa\u91d1\u6c60\u6574\u4f53\u98ce\u9669\u504f\u597d\u503e\u5411\u4e8e\u9632\u5fa1\u3002</p>"},{"location":"Quant_Report_20260303/#_3","title":"\u6280\u672f\u5f62\u6001\u70b9\u8bc4","text":"<p>\u3010\u6807\u7684 003096\u3011 *   MA20 \u8d8b\u52bf: \u7a7a\u5934\u3002\u5f53\u524d\u51c0\u503c1.6311\u663e\u8457\u4f4e\u4e8eMA20\u76841.7038\uff0c\u786e\u8ba4\u77ed\u671f\u5747\u7ebf\u7a7a\u5934\u6392\u5217\u3002 *   MACD \u4fe1\u53f7: \u7eff\u67f1\u653e\u5927\u3002DIF (-0.0231) \u4e0e DEA (-0.0171) \u5747\u4e3a\u8d1f\u503c\u4e14DIF\u5411\u4e0b\u53d1\u6563\uff0c\u7eff\u67f1\u6301\u7eed\u653e\u5927\uff0c\u8868\u660e\u7a7a\u5934\u52a8\u80fd\u6b63\u5728\u589e\u5f3a\uff0c\u77ed\u671f\u5185\u4e0b\u884c\u538b\u529b\u663e\u8457\u3002 *   \u64cd\u4f5c\u903b\u8f91: \u9274\u4e8e\u51c0\u503c\u5df2\u8dcc\u7834MA20\u4e14MACD\u7eff\u67f1\u653e\u5927\uff0c\u8be5\u6807\u7684\u77ed\u671f\u6280\u672f\u9762\u5448\u73b0\u5f31\u52bf\uff0c\u5efa\u8bae\u89c4\u907f\u6216\u6267\u884c\u51cf\u4ed3\u64cd\u4f5c\uff0c\u4ee5\u89c4\u907f\u8fdb\u4e00\u6b65\u4e0b\u884c\u98ce\u9669\u3002</p> <p>\u3010\u6807\u7684 005827\u3011 *   MA20 \u8d8b\u52bf: \u7a7a\u5934\u3002\u5f53\u524d\u51c0\u503c1.8434\u4f4e\u4e8eMA20\u76841.9187\uff0c\u77ed\u671f\u8d8b\u52bf\u540c\u6837\u5904\u4e8e\u7a7a\u5934\u3002 *   MACD \u4fe1\u53f7: \u7eff\u67f1\u653e\u5927\u3002DIF (-0.0147) \u4e0e DEA (-0.0042) \u4e3a\u8d1f\uff0c\u7eff\u67f1\u653e\u5927\uff0c\u663e\u793a\u7a7a\u5934\u52a8\u80fd\u6301\u7eed\u589e\u5f3a\uff0c\u5e02\u573a\u60c5\u7eea\u504f\u5411\u60b2\u89c2\u3002 *   \u64cd\u4f5c\u903b\u8f91: \u4e0e003096\u7c7b\u4f3c\uff0c\u8be5\u6807\u7684\u77ed\u671f\u6280\u672f\u9762\u4fe1\u53f7\u4e00\u81f4\u6307\u5411\u7a7a\u5934\u8d8b\u52bf\u5f3a\u5316\u3002\u64cd\u4f5c\u4e0a\u5e94\u4fdd\u6301\u8c28\u614e\uff0c\u4e0d\u5efa\u8bae\u4ecb\u5165\uff0c\u6301\u6709\u8005\u8003\u8651\u6b62\u635f\u6216\u51cf\u6301\u3002</p> <p>\u3010\u6807\u7684 460300\u3011 *   MA20 \u8d8b\u52bf: \u591a\u5934\u3002\u5f53\u524d\u51c0\u503c1.1783\u9ad8\u4e8eMA20\u76841.1715\uff0c\u5f62\u6210\u77ed\u671f\u5747\u7ebf\u591a\u5934\u6392\u5217\u3002 *   MACD \u4fe1\u53f7: \u7ea2\u67f1\u653e\u5927\u3002DIF (0.0025) \u4e0e DEA (0.0021) \u5747\u4e3a\u6b63\u503c\u4e14DIF\u5411\u4e0a\u53d1\u6563\uff0c\u7ea2\u67f1\u653e\u5927\uff0c\u8868\u660e\u591a\u5934\u52a8\u80fd\u6301\u7eed\u589e\u5f3a\uff0c\u77ed\u671f\u8d8b\u52bf\u79ef\u6781\u3002 *   \u64cd\u4f5c\u903b\u8f91: \u51c0\u503c\u7ad9\u7a33MA20\u4e0a\u65b9\uff0c\u4e14MACD\u7ea2\u67f1\u653e\u5927\uff0c\u663e\u793a\u591a\u5934\u8d8b\u52bf\u5065\u5eb7\u5e76\u6709\u52a0\u901f\u8ff9\u8c61\u3002\u77ed\u671f\u5185\u5177\u5907\u4e0a\u653b\u6f5c\u529b\uff0c\u53ef\u5173\u6ce8\u5176\u8868\u73b0\uff0c\u6216\u5728\u98ce\u9669\u53ef\u63a7\u7684\u524d\u63d0\u4e0b\u9002\u5ea6\u914d\u7f6e\u3002</p>"},{"location":"Quant_Report_20260303/#_4","title":"\u98ce\u63a7\u7eaa\u5f8b\u63d0\u793a","text":"<p>\u9274\u4e8e\u57fa\u91d1\u5386\u53f2\u6700\u5927\u56de\u64a4\u6570\u636e\u5747\u5904\u4e8e\u8f83\u9ad8\u6c34\u5e73\uff0c\u663e\u793a\u51fa\u663e\u8457\u7684\u6ce2\u52a8\u6027\u53ca\u6f5c\u5728\u8d44\u672c\u635f\u5931\u98ce\u9669\uff0c\u4e25\u683c\u7684\u98ce\u63a7\u7eaa\u5f8b\u81f3\u5173\u91cd\u8981\u3002</p> <ul> <li>003096 \u7684\u6700\u5927\u56de\u64a4\u9ad8\u8fbe -54.81%\uff0c005827 \u4ea6\u6709 -42.65% \u7684\u5386\u53f2\u56de\u64a4\uff0c\u800c\u5373\u4f7f\u662f\u5f53\u524d\u8868\u73b0\u5f3a\u52bf\u7684 460300 \u4e5f\u5f55\u5f97 -31.54% \u7684\u6700\u5927\u56de\u64a4\u3002</li> <li>\u6b64\u7c7b\u9ad8\u56de\u64a4\u6570\u636e\u8868\u660e\uff0c\u5728\u5e02\u573a\u9006\u8f6c\u65f6\uff0c\u77ed\u671f\u5185\u8d44\u4ea7\u4ef7\u503c\u53ef\u80fd\u9762\u4e34\u5927\u5e45\u7f29\u6c34\u3002</li> <li>\u5efa\u8bae:<ol> <li>\u4ed3\u4f4d\u7ba1\u7406: \u6839\u636e\u4e2a\u4eba\u98ce\u9669\u627f\u53d7\u80fd\u529b\uff0c\u4e25\u683c\u63a7\u5236\u5355\u53ea\u57fa\u91d1\u7684\u914d\u7f6e\u6bd4\u4f8b\uff0c\u907f\u514d\u91cd\u4ed3\u3002</li> <li>\u6b62\u635f\u8bbe\u5b9a: \u5bf9\u4e8e\u5df2\u6301\u4ed3\u7684\u6807\u7684\uff0c\u52a1\u5fc5\u8bbe\u5b9a\u660e\u786e\u7684\u6b62\u635f\u4f4d\u3002\u4e00\u65e6\u89e6\u53ca\uff0c\u65e0\u8bba\u6210\u672c\u5982\u4f55\uff0c\u4e25\u683c\u6267\u884c\u7eaa\u5f8b\u6027\u6b62\u635f\uff0c\u4ee5\u9632\u6b62\u4e8f\u635f\u8fdb\u4e00\u6b65\u6269\u5927\u3002</li> <li>\u98ce\u9669\u518d\u8bc4\u4f30: \u5bf9\u4e8e\u5386\u53f2\u56de\u64a4\u8f83\u5927\u7684\u57fa\u91d1\uff0c\u5e94\u5b9a\u671f\u91cd\u4f30\u5176\u98ce\u9669\u6536\u76ca\u6bd4\uff0c\u5e76\u7ed3\u5408\u5f53\u524d\u5e02\u573a\u73af\u5883\u8c03\u6574\u6301\u4ed3\u7b56\u7565\u3002</li> <li>\u8d44\u91d1\u4fdd\u62a4: \u4efb\u4f55\u6295\u8d44\u64cd\u4f5c\u5747\u5e94\u4ee5\u4fdd\u62a4\u672c\u91d1\u4e3a\u9996\u8981\u76ee\u6807\uff0c\u907f\u514d\u56e0\u8ffd\u6c42\u77ed\u671f\u6536\u76ca\u800c\u627f\u62c5\u65e0\u6cd5\u627f\u53d7\u7684\u98ce\u9669\u3002</li> </ol> </li> </ul>"},{"location":"Quant_Report_20260305/","title":"Quant Report 20260305","text":""},{"location":"Quant_Report_20260305/#_1","title":"\u91cf\u5316\u57fa\u51c6\u6d4b\u7b97\u4e0e\u8d8b\u52bf\u7814\u62a5","text":"<p>\u62a5\u544a\u65e5\u671f\uff1a2023-10-27</p>"},{"location":"Quant_Report_20260305/#_2","title":"\u5e02\u573a\u52a8\u80fd\u6982\u89c8","text":"<p>\u5f53\u524d\u89c2\u6d4b\u7684\u57fa\u91d1\u6c60\u6574\u4f53\u8868\u73b0\u4e3a\u7a7a\u5934\u8d8b\u52bf\u3002\u6240\u6709\u6807\u7684\u51c0\u503c\u5747\u8fd0\u884c\u4e8eMA20\u5747\u7ebf\u4e0b\u65b9\uff0c\u4e14MACD\u6307\u6807\u663e\u793a\u7eff\u67f1\u653e\u5927\uff0c\u8868\u660e\u77ed\u671f\u5747\u7ebf\u538b\u529b\u663e\u8457\uff0c\u7a7a\u5934\u52a8\u80fd\u6b63\u5728\u589e\u5f3a\u3002\u5e02\u573a\u60c5\u7eea\u504f\u4e8e\u8c28\u614e\u6216\u60b2\u89c2\uff0c\u7f3a\u4e4f\u660e\u786e\u7684\u6b62\u8dcc\u4f01\u7a33\u4fe1\u53f7\u3002</p>"},{"location":"Quant_Report_20260305/#_3","title":"\u6280\u672f\u5f62\u6001\u70b9\u8bc4","text":""},{"location":"Quant_Report_20260305/#003096","title":"\u6807\u7684 003096","text":"<ul> <li>MA20 \u8d8b\u52bf: \u51c0\u503c (1.5791) \u663e\u8457\u4f4e\u4e8e MA20 (1.6888)\uff0c\u77ed\u671f\u8d8b\u52bf\u786e\u8ba4\u4e3a\u7a7a\u5934\u3002MA20\u5747\u7ebf\u6784\u6210\u4e0a\u65b9\u5f3a\u963b\u529b\u4f4d\u3002</li> <li>MACD \u4fe1\u53f7: DIF (-0.0352) \u4f4d\u4e8e DEA (-0.0228) \u4e4b\u4e0b\uff0c\u4e14\u7eff\u67f1\u653e\u5927\uff0c\u8868\u660e\u7a7a\u5934\u52a8\u80fd\u6301\u7eed\u589e\u5f3a\uff0c\u4e0b\u884c\u8d8b\u52bf\u52a0\u901f\u3002</li> <li>\u64cd\u4f5c\u903b\u8f91: \u77ed\u671f\u5185\u4e0d\u5177\u5907\u5165\u573a\u6216\u52a0\u4ed3\u6761\u4ef6\u3002\u6301\u4ed3\u8005\u5e94\u4e25\u683c\u9075\u5faa\u6b62\u635f\u7eaa\u5f8b\uff0c\u672a\u6301\u4ed3\u8005\u4fdd\u6301\u89c2\u671b\uff0c\u7b49\u5f85\u51fa\u73b0\u660e\u786e\u7684\u5e95\u90e8\u4fe1\u53f7\u6216\u8d8b\u52bf\u53cd\u8f6c\u3002</li> </ul>"},{"location":"Quant_Report_20260305/#005827","title":"\u6807\u7684 005827","text":"<ul> <li>MA20 \u8d8b\u52bf: \u51c0\u503c (1.8053) \u8fd0\u884c\u4e8e MA20 (1.9112) \u4e4b\u4e0b\uff0c\u77ed\u671f\u5747\u7ebf\u7cfb\u7edf\u663e\u793a\u7a7a\u5934\u6392\u5217\u3002</li> <li>MACD \u4fe1\u53f7: DIF (-0.0233) \u4f4d\u4e8e DEA (-0.0103) \u4e4b\u4e0b\uff0c\u7eff\u67f1\u653e\u5927\uff0c\u7a7a\u5934\u52bf\u80fd\u6301\u7eed\u5f3a\u5316\uff0c\u672a\u89c1\u8870\u7aed\u8ff9\u8c61\u3002</li> <li>\u64cd\u4f5c\u903b\u8f91: \u7a7a\u5934\u8d8b\u52bf\u660e\u786e\uff0c\u4e0d\u5efa\u8bae\u8fdb\u884c\u591a\u5934\u64cd\u4f5c\u3002\u9700\u5bc6\u5207\u5173\u6ce8\u540e\u7eed\u91cf\u80fd\u53d8\u5316\uff0c\u76ee\u524d\u5e02\u573a\u7ed3\u6784\u4e0d\u5229\u4e8e\u591a\u65b9\u3002</li> </ul>"},{"location":"Quant_Report_20260305/#460300","title":"\u6807\u7684 460300","text":"<ul> <li>MA20 \u8d8b\u52bf: \u51c0\u503c (1.1489) \u8dcc\u7834 MA20 (1.1698)\uff0c\u77ed\u671f\u8d8b\u52bf\u8f6c\u4e3a\u5411\u4e0b\u3002\u5c3d\u7ba1\u8dcc\u7834\u5e45\u5ea6\u76f8\u5bf9\u8f83\u5c0f\uff0c\u4f46\u8d8b\u52bf\u5df2\u786e\u7acb\u3002</li> <li>MACD \u4fe1\u53f7: DIF (-0.0007) \u5df2\u5904\u4e8e DEA (0.0014) \u4e4b\u4e0b\uff0c\u4e14\u7eff\u67f1\u653e\u5927\uff0c\u663e\u793a\u7a7a\u5934\u52a8\u80fd\u5f00\u59cb\u91ca\u653e\u5e76\u589e\u5f3a\u3002</li> <li>\u64cd\u4f5c\u903b\u8f91: \u5c3d\u7ba1\u533a\u95f4\u6536\u76ca\u7387\u8868\u73b0\u76f8\u5bf9\u8f83\u597d\uff0c\u4f46\u77ed\u671f\u6280\u672f\u9762\u5df2\u8f6c\u5f31\u3002\u9274\u4e8eMACD\u7eff\u67f1\u653e\u5927\uff0c\u5e94\u89c4\u907f\u77ed\u671f\u98ce\u9669\uff0c\u89c2\u5bdf\u5176\u662f\u5426\u80fd\u5728MA20\u9644\u8fd1\u4f01\u7a33\u6216\u5feb\u901f\u6536\u590d\u3002\u5728\u672a\u786e\u8ba4\u7ad9\u7a33MA20\u524d\uff0c\u4e0d\u5efa\u8bae\u6fc0\u8fdb\u64cd\u4f5c\u3002</li> </ul>"},{"location":"Quant_Report_20260305/#_4","title":"\u98ce\u63a7\u7eaa\u5f8b\u63d0\u793a","text":"<p>\u5386\u53f2\u6700\u5927\u56de\u64a4\u6570\u636e\u663e\u793a\uff0c\u6240\u6709\u6807\u7684\u5747\u5177\u6709\u8f83\u9ad8\u7684\u6ce2\u52a8\u6027\u548c\u6f5c\u5728\u98ce\u9669\uff08003096: -54.81%, 005827: -42.65%, 460300: -31.54%\uff09\u3002\u5728\u5f53\u524d\u5e02\u573a\u6574\u4f53\u504f\u7a7a\u4e14\u6280\u672f\u6307\u6807\u663e\u793a\u7a7a\u5934\u52a8\u80fd\u589e\u5f3a\u7684\u80cc\u666f\u4e0b\uff0c\u6295\u8d44\u8005\u5e94\u4e25\u683c\u9075\u5b88\u8d44\u91d1\u7ba1\u7406\u539f\u5219\uff0c\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\uff1a</p> <ol> <li>\u660e\u786e\u7684\u6b62\u635f\u4f4d\u8bbe\u7f6e: \u5728\u5165\u573a\u524d\u8bbe\u5b9a\u5e76\u4e25\u683c\u6267\u884c\u6b62\u635f\u70b9\uff0c\u4ee5\u9650\u5236\u6f5c\u5728\u4e8f\u635f\u3002</li> <li>\u57fa\u4e8e\u98ce\u9669\u627f\u53d7\u80fd\u529b\u7684\u4ed3\u4f4d\u63a7\u5236: \u6839\u636e\u4e2a\u4eba\u98ce\u9669\u504f\u597d\u548c\u8d44\u91d1\u89c4\u6a21\uff0c\u5408\u7406\u5206\u914d\u4ed3\u4f4d\uff0c\u907f\u514d\u8fc7\u5ea6\u96c6\u4e2d\u3002</li> <li>\u907f\u514d\u76f2\u76ee\u6284\u5e95: \u5728\u8d8b\u52bf\u672a\u53cd\u8f6c\u3001\u5e95\u90e8\u4fe1\u53f7\u672a\u786e\u7acb\u524d\uff0c\u4fdd\u6301\u8010\u5fc3\uff0c\u4f18\u5148\u8003\u8651\u98ce\u9669\u89c4\u907f\u3002</li> <li>\u5b9a\u671f\u518d\u5e73\u8861: \u5ba1\u89c6\u6301\u4ed3\u7684\u98ce\u9669\u6536\u76ca\u6bd4\uff0c\u9002\u65f6\u8c03\u6574\u7ec4\u5408\u914d\u7f6e\u3002</li> </ol> <p>\u6295\u8d44\u8005\u9700\u8ba4\u8bc6\u5230\uff0c\u5386\u53f2\u4e1a\u7ee9\u4e0d\u4ee3\u8868\u672a\u6765\u8868\u73b0\uff0c\u6240\u6709\u6295\u8d44\u51b3\u7b56\u5e94\u57fa\u4e8e\u72ec\u7acb\u5224\u65ad\u5e76\u5145\u5206\u8003\u91cf\u81ea\u8eab\u98ce\u9669\u627f\u53d7\u80fd\u529b\u3002</p>"}]}