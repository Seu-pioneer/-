{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"Quant_Report_20260303/","title":"\u6bcf\u65e5\u57fa\u91d1\u91cf\u5316\u7b5b\u67e5\u4e0e\u4f30\u503c\u7814\u62a5","text":"<p>\u53d1\u5e03\u65e5\u671f\uff1a2023\u5e7410\u670827\u65e5 \u5206\u6790\u5e08\uff1a[\u60a8\u7684\u59d3\u540d/\u673a\u6784\u540d\u79f0] \u91cf\u5316\u7814\u7a76\u56e2\u961f</p>"},{"location":"Quant_Report_20260303/#_2","title":"\u91cf\u5316\u6570\u636e\u6982\u89c8","text":"<p>\u4eca\u65e5\u5bf9\u8ddf\u8e2a\u57fa\u91d1\u6c60\u4e2d\u7684\u4e09\u53ea\u6838\u5fc3\u6807\u7684\u8fdb\u884c\u4e86\u91cf\u5316\u56de\u6d4b\u6570\u636e\u7b5b\u67e5\u3002\u4ee5\u4e0b\u4e3a\u5404\u57fa\u91d1\u5728\u6307\u5b9a\u56de\u6d4b\u533a\u95f4\u5185\u7684\u6838\u5fc3\u8868\u73b0\u6570\u636e\uff1a</p> \u57fa\u91d1\u4ee3\u7801 \u533a\u95f4\u6536\u76ca\u7387 \u6700\u5927\u56de\u64a4 003096 -43.76% -54.81% 005827 -28.19% -42.65% 460300 3.41% -31.54% <p>\u6ce8\uff1a\u4ee5\u4e0a\u6570\u636e\u5747\u4e3a\u7279\u5b9a\u56de\u6d4b\u533a\u95f4\u5185\u7684\u8868\u73b0\uff0c\u4e0d\u4ee3\u8868\u672a\u6765\u8d8b\u52bf\u3002</p>"},{"location":"Quant_Report_20260303/#_3","title":"\u5f02\u52a8\u70b9\u8bc4","text":"<p>\u672c\u6b21\u7b5b\u67e5\u7ed3\u679c\u663e\u793a\uff0c\u57fa\u91d1\u6c60\u5185\u90e8\u8868\u73b0\u51fa\u73b0\u663e\u8457\u5206\u5316\uff0c\u63ed\u793a\u4e86\u5f53\u524d\u5e02\u573a\u73af\u5883\u7684\u590d\u6742\u6027\u4e0e\u7ed3\u6784\u6027\u7279\u5f81\u3002</p> <ol> <li> <p>\u6807\u7684460300\u8868\u73b0\u7a81\u51fa\uff1a \u5728\u666e\u904d\u9762\u4e34\u538b\u529b\u7684\u5e02\u573a\u73af\u5883\u4e2d\uff0c\u8be5\u57fa\u91d1\u5f55\u5f973.41%\u7684\u6b63\u5411\u533a\u95f4\u6536\u76ca\u7387\uff0c\u5c55\u73b0\u51fa\u4e00\u5b9a\u7684\u6297\u8dcc\u6027\u6216\u7279\u5b9a\u8d44\u4ea7\u914d\u7f6e\u7b56\u7565\u7684\u6709\u6548\u6027\u3002\u5c3d\u7ba1\u5176\u6700\u5927\u56de\u64a4\u4ecd\u8fbe-31.54%\uff0c\u8868\u660e\u5176\u4ecd\u53d7\u5230\u5e02\u573a\u6ce2\u52a8\u7684\u8f83\u5927\u5f71\u54cd\uff0c\u4f46\u76f8\u8f83\u4e8e\u540c\u6279\u6b21\u5176\u4ed6\u57fa\u91d1\u7684\u663e\u8457\u4e8f\u635f\uff0c\u5176\u7a7f\u8d8a\u5468\u671f\u7684\u80fd\u529b\u503c\u5f97\u6df1\u5165\u7814\u7a76\u3002\u8fd9\u53ef\u80fd\u4e0e\u5176\u6240\u6295\u8d44\u7684\u884c\u4e1a\u8d5b\u9053\u3001\u8d44\u4ea7\u7c7b\u522b\uff08\u5982\u4ef7\u503c\u80a1\u3001\u9ad8\u80a1\u606f\u8d44\u4ea7\u7b49\uff09\u6216\u57fa\u91d1\u7ecf\u7406\u7684\u9009\u80a1/\u62e9\u65f6\u80fd\u529b\u6709\u5173\u3002\u8be5\u6807\u7684\u5728\u9632\u5fa1\u6027\u6216\u7279\u5b9a\u7ed3\u6784\u6027\u884c\u60c5\u4e2d\u53ef\u80fd\u5177\u5907\u76f8\u5bf9\u4f18\u52bf\u3002</p> </li> <li> <p>\u6807\u7684003096\u4e0e005827\u6df1\u5ea6\u627f\u538b\uff1a \u4e24\u53ea\u57fa\u91d1\u5747\u5f55\u5f97\u4e25\u91cd\u4e8f\u635f\uff0c\u5176\u4e2d003096\u7684\u533a\u95f4\u6536\u76ca\u7387\u4f4e\u81f3-43.76%\uff0c\u6700\u5927\u56de\u64a4\u9ad8\u8fbe-54.81%\uff0c\u663e\u793a\u51fa\u6781\u5f3a\u7684\u4e0b\u884c\u98ce\u9669\u66b4\u9732\u3002005827\u4ea6\u8868\u73b0\u4e0d\u4f73\uff0c\u533a\u95f4\u6536\u76ca\u7387-28.19%\uff0c\u6700\u5927\u56de\u64a4-42.65%\u3002\u8fd9\u4e24\u53ea\u57fa\u91d1\u7684\u7cdf\u7cd5\u8868\u73b0\u53ef\u80fd\u6307\u5411\u5176\u91cd\u4ed3\u884c\u4e1a\u7684\u7cfb\u7edf\u6027\u98ce\u9669\uff08\u4f8b\u5982\u5bf9\u9ad8\u666f\u6c14\u5ea6\u4f46\u9ad8\u6ce2\u52a8\u884c\u4e1a\u7684\u96c6\u4e2d\u914d\u7f6e\uff09\u3001\u7ba1\u7406\u7b56\u7565\u7684\u5931\u8bef\uff08\u4f8b\u5982\u672a\u80fd\u6709\u6548\u63a7\u5236\u56de\u64a4\uff09\u6216\u5176\u6240\u6295\u8d44\u7684\u6210\u957f\u578b\u8d44\u4ea7\u5728\u5f53\u524d\u5b8f\u89c2\u73af\u5883\u4e0b\u7684\u8106\u5f31\u6027\u3002\u6295\u8d44\u8005\u9700\u8b66\u60d5\u8fd9\u7c7b\u57fa\u91d1\u5728\u5e02\u573a\u4e0b\u884c\u5468\u671f\u4e2d\u7684\u5de8\u5927\u635f\u5931\u98ce\u9669\uff0c\u5bf9\u5176\u5e95\u5c42\u8d44\u4ea7\u8d28\u91cf\u548c\u7ba1\u7406\u56e2\u961f\u80fd\u529b\u9700\u8fdb\u884c\u66f4\u4e3a\u4e25\u8c28\u7684\u8bc4\u4f30\u3002</p> </li> <li> <p>\u6574\u4f53\u56de\u64a4\u6c34\u5e73\u8b66\u793a\uff1a \u503c\u5f97\u6ce8\u610f\u7684\u662f\uff0c\u5373\u4f7f\u662f\u8868\u73b0\u76f8\u5bf9\u8f83\u597d\u7684460300\uff0c\u5176\u8d85\u8fc730%\u7684\u6700\u5927\u56de\u64a4\u4e5f\u63d0\u793a\u6211\u4eec\uff0c\u65e0\u8bba\u57fa\u91d1\u8868\u73b0\u5982\u4f55\uff0c\u5f53\u524d\u5e02\u573a\u73af\u5883\u6574\u4f53\u6ce2\u52a8\u6027\u8f83\u9ad8\uff0c\u5b58\u5728\u8f83\u5927\u7684\u8d44\u672c\u56de\u64a4\u98ce\u9669\u3002\u6240\u6709\u6807\u7684\u7684\u56de\u64a4\u5e45\u5ea6\u5747\u8f83\u5927\uff0c\u8fd9\u53ef\u80fd\u6697\u793a\u4e86\u8fc7\u53bb\u4e00\u6bb5\u65f6\u95f4\u5e02\u573a\u6574\u4f53\u7684\u5bbd\u5e45\u9707\u8361\u6216\u7ed3\u6784\u6027\u8c03\u6574\uff0c\u5bf9\u98ce\u9669\u7ba1\u7406\u80fd\u529b\u63d0\u51fa\u4e86\u66f4\u9ad8\u7684\u8981\u6c42\u3002</p> </li> </ol>"},{"location":"Quant_Report_20260303/#_4","title":"\u98ce\u9669\u63d0\u793a","text":"<ol> <li>\u5386\u53f2\u6570\u636e\u4e0d\u4ee3\u8868\u672a\u6765\uff1a \u6240\u6709\u7684\u91cf\u5316\u56de\u6d4b\u6570\u636e\u5747\u57fa\u4e8e\u5386\u53f2\u8868\u73b0\uff0c\u4e0d\u6784\u6210\u5bf9\u672a\u6765\u6536\u76ca\u7684\u4efb\u4f55\u627f\u8bfa\u6216\u4fdd\u8bc1\u3002\u5e02\u573a\u73af\u5883\u3001\u5b8f\u89c2\u7ecf\u6d4e\u653f\u7b56\u4ee5\u53ca\u884c\u4e1a\u57fa\u672c\u9762\u53d8\u5316\u83ab\u6d4b\uff0c\u8fc7\u53bb\u7684\u6210\u529f\u6216\u5931\u8d25\u4e0d\u5fc5\u7136\u5ef6\u7eed\u3002</li> <li>\u5168\u9762\u8bc4\u4f30\u4e0d\u53ef\u6216\u7f3a\uff1a \u672c\u7814\u62a5\u4ec5\u57fa\u4e8e\u6838\u5fc3\u91cf\u5316\u6570\u636e\u8fdb\u884c\u521d\u6b65\u7b5b\u9009\u4e0e\u5206\u6790\u3002\u5728\u505a\u51fa\u6295\u8d44\u51b3\u7b56\u524d\uff0c\u5efa\u8bae\u6295\u8d44\u8005\u7ed3\u5408\u57fa\u91d1\u7684\u6295\u8d44\u7b56\u7565\u3001\u57fa\u91d1\u7ecf\u7406\u7684\u5386\u53f2\u4e1a\u7ee9\u4e0e\u6295\u8d44\u98ce\u683c\u3001\u6301\u4ed3\u7ed3\u6784\u3001\u98ce\u9669\u6536\u76ca\u7279\u5f81\uff08\u5982\u590f\u666e\u6bd4\u7387\u3001\u7d22\u63d0\u8bfa\u6bd4\u7387\u7b49\uff09\u3001\u8d39\u7528\u7ed3\u6784\u53ca\u5f53\u524d\u5b8f\u89c2\u7ecf\u6d4e\u73af\u5883\u8fdb\u884c\u66f4\u5168\u9762\u7684\u6df1\u5165\u7814\u7a76\u3002</li> <li>\u5e02\u573a\u6ce2\u52a8\u6027\u8b66\u793a\uff1a \u89c2\u5bdf\u5230\u7684\u9ad8\u6700\u5927\u56de\u64a4\u8868\u660e\uff0c\u5f53\u524d\u6216\u56de\u6d4b\u671f\u95f4\u7684\u5e02\u573a\u6ce2\u52a8\u6027\u8f83\u5927\u3002\u9ad8\u6ce2\u52a8\u6027\u5728\u5e26\u6765\u6f5c\u5728\u6536\u76ca\u673a\u4f1a\u7684\u540c\u65f6\uff0c\u4e5f\u4f34\u968f\u7740\u66f4\u9ad8\u7684\u8d44\u672c\u4e8f\u635f\u98ce\u9669\u3002\u6295\u8d44\u8005\u5e94\u786e\u4fdd\u5176\u98ce\u9669\u504f\u597d\u4e0e\u6240\u9009\u57fa\u91d1\u7684\u98ce\u9669\u7b49\u7ea7\u76f8\u5339\u914d\u3002</li> <li>\u4e2a\u522b\u57fa\u91d1\u7279\u5b9a\u98ce\u9669\uff1a \u5bf9\u4e8e\u8868\u73b0\u6301\u7eed\u4f4e\u8ff7\u7684\u57fa\u91d1\uff0c\u6295\u8d44\u8005\u9700\u5ba1\u614e\u8bc4\u4f30\u5176\u662f\u5426\u5b58\u5728\u7ba1\u7406\u5c42\u9762\u3001\u7b56\u7565\u5c42\u9762\u6216\u8d44\u4ea7\u914d\u7f6e\u5c42\u9762\u7684\u7ed3\u6784\u6027\u95ee\u9898\uff0c\u8b66\u60d5\u201c\u4ef7\u503c\u9677\u9631\u201d\u6216\u201c\u98ce\u683c\u9677\u9631\u201d\u7684\u98ce\u9669\u3002\u76f2\u76ee\u6284\u5e95\u6216\u6301\u6709\u8868\u73b0\u4e0d\u4f73\u7684\u57fa\u91d1\uff0c\u53ef\u80fd\u5bfc\u81f4\u8fdb\u4e00\u6b65\u7684\u8d44\u672c\u635f\u5931\u3002</li> </ol> <p>\u672c\u7814\u62a5\u4ec5\u4f9b\u53c2\u8003\uff0c\u4e0d\u6784\u6210\u4efb\u4f55\u6295\u8d44\u5efa\u8bae\u3002\u6295\u8d44\u8005\u5e94\u72ec\u7acb\u5224\u65ad\uff0c\u81ea\u4e3b\u51b3\u7b56\uff0c\u5e76\u5bf9\u81ea\u8eab\u7684\u6295\u8d44\u884c\u4e3a\u8d1f\u8d23\u3002</p>"}]}