{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"Quant_Report_20260303/","title":"\u6bcf\u65e5\u57fa\u91d1\u91cf\u5316\u7b5b\u67e5\u4e0e\u4f30\u503c\u7814\u62a5","text":"<p>\u62a5\u544a\u65e5\u671f\uff1a2023\u5e74XX\u6708XX\u65e5</p> <p>\u672c\u7814\u62a5\u57fa\u4e8e\u6700\u65b0\u7684\u91cf\u5316\u56de\u6d4b\u6838\u5fc3\u6570\u636e\uff0c\u5bf9\u7cbe\u9009\u57fa\u91d1\u7684\u533a\u95f4\u8868\u73b0\u8fdb\u884c\u6df1\u5ea6\u5256\u6790\uff0c\u65e8\u5728\u63d0\u4f9b\u5ba2\u89c2\u3001\u4e13\u4e1a\u7684\u91cf\u5316\u89c6\u89d2\uff0c\u8f85\u52a9\u6295\u8d44\u8005\u51b3\u7b56\u3002\u6240\u6709\u6570\u636e\u5747\u6765\u6e90\u4e8e\u6700\u65b0\u56de\u6d4b\u7ed3\u679c\uff0c\u4ec5\u4f9b\u53c2\u8003\uff0c\u4e0d\u6784\u6210\u6295\u8d44\u5efa\u8bae\u3002</p>"},{"location":"Quant_Report_20260303/#_2","title":"\u91cf\u5316\u6570\u636e\u6982\u89c8","text":"<p>\u4ee5\u4e0b\u662f\u4eca\u65e5\u91cf\u5316\u7b5b\u67e5\u6240\u5173\u6ce8\u57fa\u91d1\u7684\u6838\u5fc3\u56de\u6d4b\u6570\u636e\uff1a</p> \u57fa\u91d1\u4ee3\u7801 \u533a\u95f4\u6536\u76ca\u7387 \u6700\u5927\u56de\u64a4 003096 -43.76% -54.81% 005827 -28.19% -42.65% 460300 3.41% -31.54% <p>\u6ce8\uff1a\u4ee5\u4e0a\u6570\u636e\u4e3a\u6307\u5b9a\u56de\u6d4b\u671f\u95f4\u5185\uff0c\u57fa\u4e8e\u5386\u53f2\u6570\u636e\u6a21\u62df\u6d4b\u7b97\u6240\u5f97\u7684\u6838\u5fc3\u4e1a\u7ee9\u6307\u6807\u3002</p>"},{"location":"Quant_Report_20260303/#_3","title":"\u5f02\u52a8\u70b9\u8bc4","text":"<p>\u4ece\u672c\u6b21\u91cf\u5316\u7b5b\u67e5\u7ed3\u679c\u6765\u770b\uff0c\u5404\u57fa\u91d1\u5728\u56de\u6d4b\u533a\u95f4\u5185\u7684\u8868\u73b0\u5448\u73b0\u663e\u8457\u5206\u5316\uff1a</p> <ol> <li> <p>\u57fa\u91d1003096\uff1a \u8be5\u57fa\u91d1\u5728\u56de\u6d4b\u671f\u5185\u8868\u73b0\u6700\u4e3a\u75b2\u5f31\uff0c\u5f55\u5f97\u9ad8\u8fbe-43.76%\u7684\u533a\u95f4\u6536\u76ca\u7387\u548c-54.81%\u7684\u6700\u5927\u56de\u64a4\u3002\u8fd9\u4e00\u6570\u636e\u6307\u5411\u5176\u7b56\u7565\u5728\u7279\u5b9a\u5e02\u573a\u73af\u5883\u4e0b\u53ef\u80fd\u9762\u4e34\u5de8\u5927\u6311\u6218\uff0c\u6216\u8d44\u4ea7\u914d\u7f6e\u5177\u6709\u8f83\u9ad8\u7684\u96c6\u4e2d\u5ea6\u4e0e\u6ce2\u52a8\u6027\u3002\u5982\u6b64\u6df1\u5ea6\u7684\u56de\u64a4\u8868\u660e\u5176\u51c0\u503c\u627f\u53d7\u4e86\u6781\u5927\u7684\u538b\u529b\uff0c\u5bf9\u6295\u8d44\u8005\u7684\u98ce\u9669\u627f\u53d7\u80fd\u529b\u6784\u6210\u4e25\u5cfb\u8003\u9a8c\u3002\u5efa\u8bae\u6df1\u5165\u5206\u6790\u5176\u6301\u4ed3\u7ed3\u6784\u3001\u884c\u4e1a\u66b4\u9732\u53ca\u7ba1\u7406\u4eba\u7684\u98ce\u9669\u63a7\u5236\u7b56\u7565\uff0c\u4ee5\u8bc4\u4f30\u5176\u672a\u6765\u8868\u73b0\u7684\u6f5c\u5728\u98ce\u9669\u4e0e\u673a\u9047\u3002</p> </li> <li> <p>\u57fa\u91d1005827\uff1a \u76f8\u8f83\u4e8e003096\uff0c\u8be5\u57fa\u91d1\u7684\u8868\u73b0\u7565\u663e\u5e73\u7a33\uff0c\u4f46\u4ecd\u5904\u4e8e\u663e\u8457\u4e8f\u635f\u533a\u95f4\uff0c\u533a\u95f4\u6536\u76ca\u7387\u4e3a-28.19%\uff0c\u6700\u5927\u56de\u64a4\u4e3a-42.65%\u3002\u5c3d\u7ba1\u6700\u5927\u56de\u64a4\u5e45\u5ea6\u7565\u5c0f\u4e8e003096\uff0c\u4f46\u4ecd\u5c5e\u9ad8\u98ce\u9669\u8303\u7574\u3002\u5176\u8868\u73b0\u53ef\u80fd\u4e0e\u6574\u4f53\u5e02\u573a\u98ce\u683c\u3001\u6240\u6295\u8d44\u4ea7\u7684\u884c\u4e1a\u5468\u671f\u6216\u5176\u7279\u5b9a\u7684\u6295\u8d44\u7b56\u7565\u6709\u5173\u3002\u5bf9\u4e8e\u6b64\u7c7b\u9ad8\u56de\u64a4\u57fa\u91d1\uff0c\u9700\u91cd\u70b9\u5173\u6ce8\u5176\u5728\u5e02\u573a\u5e95\u90e8\u533a\u57df\u7684\u4f30\u503c\u4fee\u590d\u6f5c\u529b\uff0c\u4ee5\u53ca\u5176\u7ba1\u7406\u56e2\u961f\u5728\u9006\u5883\u4e2d\u7684\u8c03\u6574\u80fd\u529b\u3002</p> </li> <li> <p>\u57fa\u91d1460300\uff1a \u5728\u672c\u6b21\u89c2\u5bdf\u7684\u4e09\u53ea\u57fa\u91d1\u4e2d\uff0c460300\u8868\u73b0\u51fa\u72ec\u7279\u7684\u97e7\u6027\uff0c\u5f55\u5f973.41%\u7684\u533a\u95f4\u6b63\u6536\u76ca\u3002\u5c3d\u7ba1\u5176\u6700\u5927\u56de\u64a4\u4e5f\u8fbe\u5230\u4e86-31.54%\uff0c\u8868\u660e\u5176\u5728\u56de\u6d4b\u671f\u95f4\u4e5f\u7ecf\u5386\u4e86\u663e\u8457\u7684\u6ce2\u52a8\u548c\u9636\u6bb5\u6027\u4e8f\u635f\uff0c\u4f46\u6700\u7ec8\u80fd\u591f\u5b9e\u73b0\u6b63\u5411\u56de\u62a5\uff0c\u8fd9\u6697\u793a\u5176\u53ef\u80fd\u5177\u5907\u4e00\u5b9a\u7684\u62e9\u65f6\u80fd\u529b\u3001\u8f83\u5f3a\u7684\u6297\u8dcc\u6027\uff08\u6216\u56de\u5347\u80fd\u529b\uff09\u6216\u5206\u6563\u7684\u98ce\u9669\u7ba1\u7406\u7b56\u7565\uff0c\u4f7f\u5176\u80fd\u591f\u5728\u5e02\u573a\u9707\u8361\u540e\u6062\u590d\u5e76\u5b9e\u73b0\u589e\u957f\u3002\u8fd9\u652f\u57fa\u91d1\u503c\u5f97\u91cd\u70b9\u5173\u6ce8\u5176\u5728\u56de\u64a4\u540e\u7684\u4fee\u590d\u80fd\u529b\u53ca\u5176\u80cc\u540e\u7684\u7b56\u7565\u903b\u8f91\uff0c\u5c24\u5176\u662f\u5728\u5f53\u524d\u5e02\u573a\u73af\u5883\u4e0b\uff0c\u5176\u98ce\u9669\u63a7\u5236\u4e0e\u6536\u76ca\u751f\u6210\u80fd\u529b\u66f4\u663e\u7a00\u7f3a\u6027\u3002</p> </li> </ol>"},{"location":"Quant_Report_20260303/#_4","title":"\u98ce\u9669\u63d0\u793a","text":"<ol> <li>\u5e02\u573a\u6ce2\u52a8\u98ce\u9669\uff1a \u672c\u6b21\u7b5b\u9009\u51fa\u7684\u90e8\u5206\u57fa\u91d1\u56de\u64a4\u5e45\u5ea6\u8f83\u5927\uff0c\u53cd\u6620\u51fa\u5e02\u573a\u6574\u4f53\u6216\u7279\u5b9a\u6295\u8d44\u9886\u57df\u53ef\u80fd\u5b58\u5728\u8f83\u9ad8\u6ce2\u52a8\u6027\u3002\u6295\u8d44\u8005\u9700\u5145\u5206\u8ba4\u8bc6\u5230\u5e02\u573a\u56fa\u6709\u7684\u4e0d\u786e\u5b9a\u6027\uff0c\u8b66\u60d5\u6781\u7aef\u884c\u60c5\u5bf9\u57fa\u91d1\u51c0\u503c\u9020\u6210\u7684\u51b2\u51fb\u3002</li> <li>\u5386\u53f2\u6570\u636e\u5c40\u9650\u6027\uff1a \u6240\u6709\u56de\u6d4b\u6570\u636e\u5747\u57fa\u4e8e\u5386\u53f2\u8868\u73b0\uff0c\u4e0d\u4ee3\u8868\u672a\u6765\u3002\u57fa\u91d1\u8fc7\u5f80\u7684\u6536\u76ca\u6216\u635f\u5931\u4e0d\u9884\u793a\u5176\u672a\u6765\u7684\u8868\u73b0\u3002\u57fa\u91d1\u7684\u98ce\u9669\u7b49\u7ea7\u3001\u6295\u8d44\u7b56\u7565\u3001\u7ba1\u7406\u4eba\u80fd\u529b\u53ca\u5e02\u573a\u73af\u5883\u53d8\u5316\u5747\u53ef\u80fd\u5bf9\u672a\u6765\u4e1a\u7ee9\u4ea7\u751f\u91cd\u5927\u5f71\u54cd\u3002</li> <li>\u9ad8\u56de\u64a4\u9ad8\u6ce2\u52a8\u8b66\u793a\uff1a \u5bf9\u4e8e\u6700\u5927\u56de\u64a4\u5e45\u5ea6\u8d85\u8fc730%\u751a\u81f350%\u7684\u57fa\u91d1\uff0c\u6295\u8d44\u8005\u5e94\u5ba1\u614e\u8bc4\u4f30\u5176\u98ce\u9669\u627f\u53d7\u80fd\u529b\u3002\u6b64\u7c7b\u57fa\u91d1\u7684\u51c0\u503c\u6ce2\u52a8\u5267\u70c8\uff0c\u53ef\u80fd\u5728\u77ed\u671f\u5185\u9020\u6210\u8f83\u5927\u7684\u8d26\u9762\u635f\u5931\u3002\u5728\u6295\u8d44\u6b64\u7c7b\u57fa\u91d1\u524d\uff0c\u52a1\u5fc5\u6df1\u5165\u4e86\u89e3\u5176\u6295\u8d44\u7ec4\u5408\u3001\u98ce\u9669\u655e\u53e3\u53ca\u7ba1\u7406\u56e2\u961f\u7684\u98ce\u9669\u63a7\u5236\u80fd\u529b\u3002</li> <li>\u7b56\u7565\u9002\u5e94\u6027\u98ce\u9669\uff1a \u57fa\u91d1\u7684\u7b56\u7565\u5728\u7279\u5b9a\u5e02\u573a\u73af\u5883\u4e0b\u53ef\u80fd\u8868\u73b0\u4e0d\u4f73\u3002\u5bf9\u4e8e\u957f\u671f\u8868\u73b0\u4e0d\u4f73\u6216\u56de\u64a4\u5de8\u5927\u7684\u57fa\u91d1\uff0c\u9700\u8b66\u60d5\u5176\u7b56\u7565\u662f\u5426\u4ecd\u80fd\u9002\u5e94\u5f53\u524d\u53ca\u672a\u6765\u5e02\u573a\u3002</li> </ol> <p>\u6211\u4eec\u5efa\u8bae\u6295\u8d44\u8005\u5728\u505a\u51fa\u4efb\u4f55\u6295\u8d44\u51b3\u7b56\u524d\uff0c\u52a1\u5fc5\u7ed3\u5408\u81ea\u8eab\u7684\u98ce\u9669\u504f\u597d\u3001\u6295\u8d44\u76ee\u6807\u53ca\u8d44\u91d1\u72b6\u51b5\uff0c\u5e76\u8be6\u7ec6\u9605\u8bfb\u57fa\u91d1\u6cd5\u5f8b\u6587\u4ef6\uff0c\u5fc5\u8981\u65f6\u54a8\u8be2\u4e13\u4e1a\u7684\u8d22\u52a1\u987e\u95ee\u3002</p> <p>\u514d\u8d23\u58f0\u660e\uff1a \u672c\u62a5\u544a\u6240\u6709\u5185\u5bb9\u4ec5\u4f9b\u53c2\u8003\uff0c\u4e0d\u6784\u6210\u4efb\u4f55\u6295\u8d44\u5efa\u8bae\u3002\u6211\u4eec\u5df2\u529b\u6c42\u62a5\u544a\u5185\u5bb9\u7684\u5ba2\u89c2\u3001\u516c\u6b63\uff0c\u4f46\u5bf9\u4fe1\u606f\u7684\u51c6\u786e\u6027\u3001\u5b8c\u6574\u6027\u6216\u6709\u6548\u6027\u4e0d\u4f5c\u4efb\u4f55\u660e\u793a\u6216\u6697\u793a\u7684\u4fdd\u8bc1\u3002\u6295\u8d44\u8005\u636e\u6b64\u505a\u51fa\u7684\u4efb\u4f55\u6295\u8d44\u51b3\u7b56\u4e0e\u672c\u516c\u53f8\u53ca\u4f5c\u8005\u65e0\u5173\u3002\u5e02\u573a\u6709\u98ce\u9669\uff0c\u6295\u8d44\u9700\u8c28\u614e\u3002</p>"}]}