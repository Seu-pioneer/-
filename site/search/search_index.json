{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"Quant_Report_20260303/","title":"\u6bcf\u65e5\u57fa\u91d1\u91cf\u5316\u7b5b\u67e5\u4e0e\u4f30\u503c\u7814\u62a5","text":"<p>\u53d1\u5e03\u65e5\u671f\uff1a 2023\u5e7410\u670827\u65e5</p>"},{"location":"Quant_Report_20260303/#_2","title":"\u91cf\u5316\u6570\u636e\u6982\u89c8","text":"<p>\u4eca\u65e5\u91cf\u5316\u7b5b\u9009\u7ed3\u679c\u663e\u793a\uff0c\u4e09\u53ea\u76d1\u6d4b\u57fa\u91d1\u5728\u6307\u5b9a\u56de\u6d4b\u533a\u95f4\u5185\u8868\u73b0\u51fa\u663e\u8457\u5206\u5316\u3002\u6838\u5fc3\u4e1a\u7ee9\u6307\u6807\u5982\u4e0b\uff1a</p> \u6807\u7684\u57fa\u91d1\u4ee3\u7801 \u533a\u95f4\u6536\u76ca\u7387 \u6700\u5927\u56de\u64a4 003096 -43.76% -54.81% 005827 -28.19% -42.65% 460300 3.41% -31.54% <p>\u6ce8\uff1a\u4ee5\u4e0a\u6570\u636e\u5747\u4e3a\u6307\u5b9a\u56de\u6d4b\u533a\u95f4\u5185\u8868\u73b0\uff0c\u4e0d\u4ee3\u8868\u672a\u6765\u8d8b\u52bf\u3002</p>"},{"location":"Quant_Report_20260303/#_3","title":"\u5f02\u52a8\u70b9\u8bc4","text":""},{"location":"Quant_Report_20260303/#003096-005827","title":"\u663e\u8457\u627f\u538b\u6807\u7684\uff1a003096, 005827","text":"<p>\u6807\u7684003096\u548c005827\u5728\u56de\u6d4b\u533a\u95f4\u5185\u8868\u73b0\u6781\u5176\u4e0d\u4f73\uff0c\u5206\u522b\u5f55\u5f97-43.76%\u548c-28.19%\u7684\u533a\u95f4\u6536\u76ca\u7387\uff0c\u4f34\u968f\u9ad8\u8fbe-54.81%\u548c-42.65%\u7684\u6700\u5927\u56de\u64a4\u3002</p> <ul> <li>\u6df1\u5ea6\u5256\u6790\uff1a \u5982\u6b64\u5267\u70c8\u7684\u4e8f\u635f\u548c\u56de\u64a4\uff0c\u6697\u793a\u8fd9\u4e24\u53ea\u57fa\u91d1\u53ef\u80fd\u9762\u4e34\u4ee5\u4e0b\u4e00\u79cd\u6216\u591a\u79cd\u60c5\u51b5\uff1a<ol> <li>\u91cd\u4ed3\u677f\u5757\u906d\u53d7\u7cfb\u7edf\u6027\u51b2\u51fb\uff1a \u82e5\u4e3b\u8981\u6295\u8d44\u4e8e\u7279\u5b9a\u884c\u4e1a\uff08\u5982\u9ad8\u6210\u957f\u3001\u79d1\u6280\u3001\u6d88\u8d39\u7b49\uff09\uff0c\u5728\u5e02\u573a\u98ce\u683c\u8f6c\u6362\u6216\u884c\u4e1a\u666f\u6c14\u5ea6\u4e0b\u884c\u65f6\uff0c\u51c0\u503c\u5bb9\u6613\u5927\u5e45\u4e0b\u8dcc\u3002\u5176\u6781\u9ad8\u7684\u6700\u5927\u56de\u64a4\u8868\u660e\u5728\u5e02\u573a\u8c03\u6574\u4e2d\u672a\u80fd\u6709\u6548\u63a7\u5236\u4e0b\u884c\u98ce\u9669\u3002</li> <li>\u6295\u8d44\u7b56\u7565\u5931\u6548\u6216\u4e0d\u9002\u5e94\u5f53\u524d\u5e02\u573a\u73af\u5883\uff1a \u57fa\u91d1\u7ecf\u7406\u7684\u9009\u80a1\u6216\u62e9\u65f6\u7b56\u7565\u53ef\u80fd\u4e0e\u5f53\u524d\u5b8f\u89c2\u7ecf\u6d4e\u5468\u671f\u6216\u5e02\u573a\u7ed3\u6784\u4e0d\u5339\u914d\uff0c\u5bfc\u81f4\u6301\u7eed\u8dd1\u8f93\u3002</li> <li>\u6d41\u52a8\u6027\u98ce\u9669\u6216\u96c6\u4e2d\u5ea6\u98ce\u9669\uff1a \u6301\u4ed3\u53ef\u80fd\u8fc7\u4e8e\u96c6\u4e2d\u4e8e\u6d41\u52a8\u6027\u8f83\u5dee\u6216\u6ce2\u52a8\u6027\u6781\u9ad8\u7684\u8d44\u4ea7\uff0c\u5bfc\u81f4\u5728\u5e02\u573a\u629b\u552e\u65f6\u51fa\u73b0\u8e29\u8e0f\u6548\u5e94\u3002</li> </ol> </li> <li>\u6f5c\u5728\u8b66\u793a\uff1a \u8fd9\u4e24\u53ea\u57fa\u91d1\u5728\u6240\u76d1\u6d4b\u5468\u671f\u5185\u672a\u80fd\u5c55\u73b0\u51fa\u6709\u6548\u7684\u6297\u98ce\u9669\u80fd\u529b\u6216\u4ef7\u503c\u521b\u9020\u80fd\u529b\u3002\u5bf9\u4e8e\u6f5c\u5728\u6295\u8d44\u8005\u800c\u8a00\uff0c\u9700\u5bf9\u5176\u5e95\u5c42\u8d44\u4ea7\u8d28\u91cf\u3001\u884c\u4e1a\u914d\u7f6e\u3001\u6301\u4ed3\u96c6\u4e2d\u5ea6\u4ee5\u53ca\u57fa\u91d1\u7ecf\u7406\u7684\u98ce\u9669\u7ba1\u7406\u80fd\u529b\u8fdb\u884c\u66f4\u6df1\u5165\u3001\u66f4\u5168\u9762\u7684\u5c3d\u804c\u8c03\u67e5\uff0c\u4ee5\u8bc4\u4f30\u5176\u662f\u5426\u4ecd\u5177\u957f\u671f\u6295\u8d44\u4ef7\u503c\uff0c\u6216\u662f\u5426\u5b58\u5728\u201c\u4ef7\u503c\u9677\u9631\u201d\u7684\u98ce\u9669\u3002</li> </ul>"},{"location":"Quant_Report_20260303/#460300","title":"\u76f8\u5bf9\u7a33\u5065\u6807\u7684\uff1a460300","text":"<p>\u4e0e\u524d\u4e24\u8005\u5f62\u6210\u9c9c\u660e\u5bf9\u6bd4\u7684\u662f\uff0c\u6807\u7684460300\u5728\u540c\u4e00\u56de\u6d4b\u533a\u95f4\u5185\u53d6\u5f97\u4e863.41%\u7684\u6b63\u6536\u76ca\uff0c\u5c3d\u7ba1\u4e5f\u7ecf\u5386\u4e86-31.54%\u7684\u6700\u5927\u56de\u64a4\uff0c\u4f46\u6700\u7ec8\u5b9e\u73b0\u4e86\u51c0\u503c\u589e\u957f\u3002</p> <ul> <li>\u6df1\u5ea6\u5256\u6790\uff1a \u8fd9\u4e00\u8868\u73b0\u8bf4\u660e460300\u53ef\u80fd\u5177\u5907\uff1a<ol> <li>\u66f4\u5f3a\u7684\u9009\u80a1\u80fd\u529b\u6216\u884c\u4e1a\u914d\u7f6e\u4f18\u52bf\uff1a \u5728\u590d\u6742\u7684\u5e02\u573a\u73af\u5883\u4e0b\uff0c\u8be5\u57fa\u91d1\u80fd\u591f\u6293\u4f4f\u7ed3\u6784\u6027\u673a\u4f1a\uff0c\u5b9e\u73b0\u8d85\u989d\u6536\u76ca\u3002\u5176\u6b63\u5411\u7684\u533a\u95f4\u6536\u76ca\u7387\u5c24\u5176\u503c\u5f97\u5173\u6ce8\uff0c\u8868\u660e\u5b83\u53ef\u80fd\u6709\u6548\u5730\u89c4\u907f\u4e86\u5e02\u573a\u5927\u90e8\u5206\u7684\u4e0b\u884c\u98ce\u9669\uff0c\u6216\u662f\u5728\u7279\u5b9a\u9886\u57df\u6355\u6349\u5230\u4e86\u5f3a\u52b2\u7684\u589e\u957f\u70b9\u3002</li> <li>\u6709\u6548\u7684\u98ce\u9669\u7ba1\u7406\u7b56\u7565\u4e0e\u56de\u64a4\u4fee\u590d\u80fd\u529b\uff1a \u5c3d\u7ba1\u51fa\u73b0\u8f83\u5927\u56de\u64a4\uff0c\u4f46\u6700\u7ec8\u80fd\u4fee\u590d\u5e76\u5b9e\u73b0\u76c8\u5229\uff0c\u53ef\u80fd\u610f\u5473\u7740\u5176\u5728\u7ecf\u5386\u5e02\u573a\u8c03\u6574\u540e\u6709\u8f83\u5f3a\u7684\u53cd\u5f39\u80fd\u529b\uff0c\u6216\u5728\u906d\u9047\u77ed\u671f\u4e0d\u5229\u56e0\u7d20\u65f6\uff0c\u5176\u6838\u5fc3\u8d44\u4ea7\u4ecd\u5177\u5907\u97e7\u6027\u3002\u8fd9\u53ef\u80fd\u5f52\u56e0\u4e8e\u5176\u6295\u8d44\u7ec4\u5408\u7684\u591a\u5143\u5316\u3001\u9ad8\u8d28\u91cf\u7684\u8d44\u4ea7\u9009\u62e9\uff0c\u6216\u7075\u6d3b\u7684\u4ed3\u4f4d\u8c03\u6574\u3002</li> <li>\u53ef\u80fd\u6295\u8d44\u4e8e\u5177\u6709\u97e7\u6027\u6216\u9006\u5468\u671f\u7279\u6027\u7684\u8d44\u4ea7\uff1a \u4f8b\u5982\uff0c\u5177\u5907\u7a33\u5b9a\u73b0\u91d1\u6d41\u7684\u9632\u5fa1\u6027\u677f\u5757\u3001\u4f4e\u4f30\u503c\u84dd\u7b79\u80a1\uff0c\u6216\u5728\u7279\u5b9a\u653f\u7b56\u6276\u6301\u4e0b\u8868\u73b0\u5f3a\u52b2\u7684\u7ec6\u5206\u8d5b\u9053\u3002</li> </ol> </li> <li>\u6f5c\u5728\u4ef7\u503c\uff1a 460300\u5728\u5f53\u524d\u6570\u636e\u8868\u73b0\u4e0b\uff0c\u65e0\u7591\u662f\u4eca\u65e5\u7b5b\u9009\u4e2d\u8868\u73b0\u6700\u4eae\u773c\u7684\u76ee\u6807\u3002\u503c\u5f97\u8fdb\u4e00\u6b65\u63a2\u7a76\u5176\u5177\u4f53\u7684\u6295\u8d44\u7b56\u7565\uff08\u5982\u4ef7\u503c\u3001\u6210\u957f\u3001\u5747\u8861\uff09\u3001\u6301\u4ed3\u7ed3\u6784\u3001\u57fa\u91d1\u7ecf\u7406\u7684\u6295\u8d44\u7406\u5ff5\u4ee5\u53ca\u5176\u4e1a\u7ee9\u6765\u6e90\u7684\u6301\u7eed\u6027\uff0c\u4ee5\u8bc4\u4f30\u5176\u662f\u5426\u80fd\u6301\u7eed\u8dd1\u8d62\u5e02\u573a\u3002</li> </ul>"},{"location":"Quant_Report_20260303/#_4","title":"\u98ce\u9669\u63d0\u793a","text":"<ol> <li>\u5386\u53f2\u6570\u636e\u4e0d\u4ee3\u8868\u672a\u6765\uff1a \u672c\u62a5\u544a\u57fa\u4e8e\u7279\u5b9a\u56de\u6d4b\u533a\u95f4\u6570\u636e\uff0c\u57fa\u91d1\u8fc7\u5f80\u4e1a\u7ee9\u4e0d\u9884\u793a\u5176\u672a\u6765\u8868\u73b0\u3002\u5e02\u573a\u73af\u5883\u3001\u653f\u7b56\u53d8\u5316\u3001\u57fa\u91d1\u7ecf\u7406\u53d8\u66f4\u3001\u6295\u8d44\u7b56\u7565\u8c03\u6574\u7b49\u56e0\u7d20\u5747\u53ef\u80fd\u5bf9\u672a\u6765\u6536\u76ca\u4ea7\u751f\u91cd\u5927\u5f71\u54cd\u3002</li> <li>\u6570\u636e\u5c40\u9650\u6027\uff1a \u6b64\u6b21\u5206\u6790\u4ec5\u57fa\u4e8e\u533a\u95f4\u6536\u76ca\u7387\u548c\u6700\u5927\u56de\u64a4\u4e24\u4e2a\u6838\u5fc3\u6307\u6807\u3002\u5b8c\u6574\u7684\u91cf\u5316\u8bc4\u4f30\u5e94\u6db5\u76d6\u66f4\u591a\u7ef4\u5ea6\uff0c\u5982\u590f\u666e\u6bd4\u7387\u3001\u7d22\u8bfa\u6bd4\u7387\u3001\u963f\u5c14\u6cd5\u3001\u8d1d\u5854\u3001\u4fe1\u606f\u6bd4\u7387\u3001\u6ce2\u52a8\u7387\u7b49\u98ce\u9669\u8c03\u6574\u540e\u6536\u76ca\u6307\u6807\uff0c\u4ee5\u53ca\u7ed3\u5408\u66f4\u8be6\u7ec6\u7684\u8d44\u4ea7\u914d\u7f6e\u8be6\u60c5\u3001\u884c\u4e1a\u66b4\u9732\u3001\u6301\u4ed3\u96c6\u4e2d\u5ea6\u7b49\u4fe1\u606f\uff0c\u5e76\u8f85\u4ee5\u5b9a\u6027\u5206\u6790\u3002</li> <li>\u5e02\u573a\u6ce2\u52a8\u98ce\u9669\uff1a \u5f53\u524d\u5168\u7403\u7ecf\u6d4e\u548c\u91d1\u878d\u5e02\u573a\u4ecd\u5b58\u5728\u4e0d\u786e\u5b9a\u6027\uff0c\u5404\u7c7b\u98ce\u9669\u4e8b\u4ef6\u53ef\u80fd\u968f\u65f6\u53d1\u751f\u3002\u6295\u8d44\u8005\u5e94\u8b66\u60d5\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u5b8f\u89c2\u7ecf\u6d4e\u98ce\u9669\u3001\u653f\u7b56\u98ce\u9669\u3001\u6d41\u52a8\u6027\u98ce\u9669\u53ca\u4e2a\u522b\u57fa\u91d1\u7279\u6709\u98ce\u9669\u3002</li> <li>\u6295\u8d44\u5efa\u8bae\uff1a \u672c\u62a5\u544a\u5185\u5bb9\u4ec5\u4e3a\u4fe1\u606f\u53c2\u8003\uff0c\u4e0d\u6784\u6210\u4efb\u4f55\u6295\u8d44\u5efa\u8bae\u3002\u6295\u8d44\u8005\u5728\u505a\u51fa\u4efb\u4f55\u6295\u8d44\u51b3\u7b56\u524d\uff0c\u52a1\u5fc5\u8fdb\u884c\u5168\u9762\u7684\u5c3d\u804c\u8c03\u67e5\uff0c\u6df1\u5165\u7406\u89e3\u4ea7\u54c1\u7279\u6027\uff0c\u5e76\u7ed3\u5408\u81ea\u8eab\u7684\u98ce\u9669\u627f\u53d7\u80fd\u529b\u3001\u6295\u8d44\u76ee\u6807\u548c\u8d22\u52a1\u72b6\u51b5\u3002</li> </ol> <p>\u514d\u8d23\u58f0\u660e\uff1a \u672c\u62a5\u544a\u5185\u5bb9\u57fa\u4e8e\u5df2\u77e5\u6570\u636e\u548c\u4e13\u4e1a\u5224\u65ad\uff0c\u529b\u6c42\u5ba2\u89c2\u516c\u6b63\uff0c\u4f46\u4e0d\u5bf9\u5176\u51c6\u786e\u6027\u3001\u5b8c\u6574\u6027\u6216\u53ca\u65f6\u6027\u505a\u51fa\u4efb\u4f55\u4fdd\u8bc1\u3002\u672c\u62a5\u544a\u6240\u6709\u89c2\u70b9\u4ec5\u4f9b\u53c2\u8003\uff0c\u4e0d\u6784\u6210\u6295\u8d44\u5efa\u8bae\u3002\u6295\u8d44\u8005\u636e\u6b64\u64cd\u4f5c\uff0c\u98ce\u9669\u81ea\u62c5\u3002</p>"}]}